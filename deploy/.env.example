# Réglages du déploiement VISION — copier en deploy/.env (jamais versionné) puis remplir.
# docker compose lit ce fichier automatiquement : plus besoin de retaper les mots de passe.

# Mots de passe. Ne pas les changer après le premier lancement : la base les a enregistrés.
PG_ADMIN_PASSWORD=change-moi-admin
PG_APP_PASSWORD=change-moi-app
KC_ADMIN_PASSWORD=change-moi-kc

# VISION AI — vide = pas de modèle, la barre répond avec le moteur de règles.
# Ollama dans la stack Docker (machine Intel ou sans carte graphique) :
#   COMPOSE_PROFILES=ai
#   AI_BASE_URL=http://ollama:11434
#   AI_MODEL=ministral-3:3b
#   puis, une fois : docker compose -f deploy/docker-compose.yml exec ollama ollama pull ministral-3:3b
# Ollama installé sur la machine (Mac Apple M, hors Docker) :
#   AI_BASE_URL=http://host.docker.internal:11434
#   AI_MODEL=ministral-3:3b      (ou ministral-3:8b, mistral-small selon la mémoire)
# Cloud souverain (OVHcloud AI Endpoints) :
#   AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net
#   AI_MODEL=Mistral-Small-3.2-24B-Instruct-2506
#   AI_API_KEY=<jeton OVHcloud>
COMPOSE_PROFILES=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=180000

# Données Monde
WORLD_SOURCES=usgs,gdacs
WORLD_OFFLINE=false
ACLED_EMAIL=
ACLED_PASSWORD=
